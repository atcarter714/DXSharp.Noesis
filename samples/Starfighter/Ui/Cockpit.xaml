<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="Fonts/#PT Root UI" TextElement.FontSize="13" TextElement.Foreground="#DDEEF0"
      ClipToBounds="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ion" Color="#79F5E7"/>
    <SolidColorBrush x:Key="Sky" Color="#72CFF5"/>
    <SolidColorBrush x:Key="Amber" Color="#FFC080"/>
    <SolidColorBrush x:Key="Red" Color="#FF776D"/>
    <SolidColorBrush x:Key="Dim" Color="#7594A3"/>
    <SolidColorBrush x:Key="Glass" Color="#69081721"/>
    <SolidColorBrush x:Key="GlassDeep" Color="#B3081721"/>
    <Style x:Key="Micro" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BigReadout" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E7FAF7"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#A9123541"/>
      <Setter Property="Foreground" Value="#E2FBF8"/>
      <Setter Property="BorderBrush" Value="#607CC9C9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#D02C7180"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="#C0A9FFF4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#E34DB5A9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- The entire interface is a transparent avionics overlay. The 3D cockpit is rendered underneath it. -->
  <Grid Margin="18">
    <!-- Thin top glareshield / mission ribbon. -->
    <Grid VerticalAlignment="Top" Height="58" IsHitTestVisible="False">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="480"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="16,8,0,0">
        <Border Width="30" Height="30" CornerRadius="15" BorderBrush="{StaticResource Ion}" BorderThickness="1" Margin="0,0,10,0">
          <TextBlock Text="V" Foreground="{StaticResource Ion}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock Text="VANGUARD  /  FIGHTER SYSTEMS" Foreground="{StaticResource Ion}" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock Text="K-09  ·  HELIOS DEBRIS FIELD  ·  PATROL 07" Foreground="#A4BBC5" FontSize="8" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0">
        <TextBlock Text="{Binding HeadingText}" Foreground="{StaticResource Ion}" FontSize="12" HorizontalAlignment="Center"/>
        <Canvas Width="420" Height="22" IsHitTestVisible="False">
          <Line X1="0" Y1="18" X2="420" Y2="18" Stroke="#536B9A9E" StrokeThickness="1"/>
          <Line X1="210" Y1="0" X2="210" Y2="21" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
          <Line X1="35" Y1="10" X2="35" Y2="18" Stroke="#86BAC6C8"/><Line X1="70" Y1="13" X2="70" Y2="18" Stroke="#86BAC6C8"/>
          <Line X1="105" Y1="10" X2="105" Y2="18" Stroke="#86BAC6C8"/><Line X1="140" Y1="13" X2="140" Y2="18" Stroke="#86BAC6C8"/>
          <Line X1="175" Y1="10" X2="175" Y2="18" Stroke="#86BAC6C8"/><Line X1="245" Y1="10" X2="245" Y2="18" Stroke="#86BAC6C8"/>
          <Line X1="280" Y1="13" X2="280" Y2="18" Stroke="#86BAC6C8"/><Line X1="315" Y1="10" X2="315" Y2="18" Stroke="#86BAC6C8"/>
          <Line X1="350" Y1="13" X2="350" Y2="18" Stroke="#86BAC6C8"/><Line X1="385" Y1="10" X2="385" Y2="18" Stroke="#86BAC6C8"/>
        </Canvas>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,14,0">
        <StackPanel Margin="0,0,24,0"><TextBlock Text="SORTIE SCORE" Style="{StaticResource Micro}"/><TextBlock Text="{Binding ScoreText}" Foreground="#E7FAF7" FontSize="20" HorizontalAlignment="Right"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="CONTRACT" Style="{StaticResource Micro}"/><TextBlock Text="{Binding WaveText}" Foreground="{StaticResource Amber}" FontSize="20" HorizontalAlignment="Right"/></StackPanel>
        <StackPanel><TextBlock Text="SPLASHES" Style="{StaticResource Micro}"/><TextBlock Text="{Binding KillsText}" Foreground="{StaticResource Sky}" FontSize="20" HorizontalAlignment="Right"/></StackPanel>
      </StackPanel>
    </Grid>

    <!-- Port-side flight instruments: floating rails, not dashboard cards. -->
    <StackPanel Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,54,0,98" Tag="InputSurface">
      <Border Background="{StaticResource Glass}" BorderBrush="#6C6AD0CB" BorderThickness="1,0,0,1" Padding="13,12" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="01  /  FLIGHT CONTROL" Style="{StaticResource Micro}"/>
          <TextBlock Text="{Binding SpeedText}" Style="{StaticResource BigReadout}" Margin="0,5,0,1"/>
          <TextBlock Text="{Binding VectorText}" Foreground="#83C8CE" FontSize="9"/>
          <TextBlock Text="{Binding AttitudeText}" Foreground="#B4CDD3" FontSize="9" Margin="0,5,0,0"/>
          <TextBlock Text="{Binding PositionText}" Foreground="#7997A2" FontSize="8" Margin="0,3,0,0"/>
          <Border Height="1" Background="#496C8C91" Margin="0,11,0,9"/>
          <DockPanel><TextBlock Text="HULL / FRAME" Foreground="#B9CBD0" FontSize="9"/><TextBlock Text="{Binding HullText}" Foreground="{StaticResource Red}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
          <Border Height="4" Background="#293B47" Margin="0,5,0,8"><Border Background="#F07970" Width="{Binding HullBarWidth}" HorizontalAlignment="Left"/></Border>
          <DockPanel><TextBlock Text="DEFLECTOR SHIELD" Foreground="#B9CBD0" FontSize="9"/><TextBlock Text="{Binding ShieldText}" Foreground="{StaticResource Sky}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
          <Border Height="4" Background="#293B47" Margin="0,5,0,0"><Border Background="#64D6F4" Width="{Binding ShieldBarWidth}" HorizontalAlignment="Left"/></Border>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Glass}" BorderBrush="#6C6AD0CB" BorderThickness="1,0,0,1" Padding="13,11">
        <StackPanel>
          <TextBlock Text="02  /  POWER PLANT" Style="{StaticResource Micro}"/>
          <DockPanel Margin="0,7,0,2"><TextBlock Text="AFTERBURNER" Foreground="#BED1D4" FontSize="9"/><TextBlock Text="{Binding BoostText}" Foreground="{StaticResource Ion}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <Border Height="4" Background="#293B47"><Border Background="#75E8BC" Width="{Binding BoostBarWidth}" HorizontalAlignment="Left"/></Border>
          <DockPanel Margin="0,9,0,2"><TextBlock Text="EMITTER HEAT" Foreground="#BED1D4" FontSize="9"/><TextBlock Text="{Binding HeatText}" Foreground="{StaticResource Amber}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <Border Height="4" Background="#293B47"><Border Background="#EAA16B" Width="{Binding HeatBarWidth}" HorizontalAlignment="Left"/></Border>
          <TextBlock Text="{Binding FlightMode}" Foreground="#84BABF" FontSize="8" Margin="0,9,0,0"/>
          <Button x:Name="CenterLookButton" Content="CENTER PILOT VIEW" Command="{Binding CenterLookCommand}" Margin="0,9,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Starboard tactical scope with a live, animated sweep. -->
    <Border Width="204" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,54,16,98"
            Background="{StaticResource Glass}" BorderBrush="#6C6AD0CB" BorderThickness="0,1,1,1" Padding="12,12" Tag="InputSurface">
      <StackPanel>
        <DockPanel><TextBlock Text="03  /  TACTICAL SCOPE" Style="{StaticResource Micro}"/><TextBlock Text="{Binding ContactCountText}" Foreground="{StaticResource Amber}" FontSize="8" HorizontalAlignment="Right"/></DockPanel>
        <Grid Width="174" Height="174" HorizontalAlignment="Center" Margin="0,8,0,9">
          <Ellipse Fill="#42101E2A" Stroke="#687FC3C3" StrokeThickness="1"/>
          <Ellipse Margin="23" Stroke="#3C82A7AC" StrokeThickness="1"/>
          <Ellipse Margin="48" Stroke="#3C82A7AC" StrokeThickness="1"/>
          <Ellipse Margin="72" Stroke="#3C82A7AC" StrokeThickness="1"/>
          <Line X1="87" Y1="0" X2="87" Y2="174" Stroke="#457FA1A7"/>
          <Line X1="0" Y1="87" X2="174" Y2="87" Stroke="#457FA1A7"/>
          <ItemsControl ItemsSource="{Binding RadarContacts}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="174" Height="174"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/>
            </Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="{Binding Color}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Line X1="87" Y1="87" X2="87" Y2="9" Stroke="{StaticResource Ion}" StrokeThickness="1.5">
            <Line.RenderTransform><RotateTransform x:Name="RadarSweep" CenterX="87" CenterY="87"/></Line.RenderTransform>
            <Line.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="RadarSweep" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.2"/>
            </Storyboard></BeginStoryboard></EventTrigger></Line.Triggers>
          </Line>
          <Ellipse Width="6" Height="6" Fill="{StaticResource Ion}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding TargetText}" Foreground="{StaticResource Ion}" FontSize="9" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding TargetName}" Foreground="#F4D6B0" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        <TextBlock Text="{Binding TargetRange}" Foreground="#B4CDD3" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,7"/>
        <Button x:Name="TargetCycleButton" Content="⌖  CYCLE CONTACT" Command="{Binding TargetCycleCommand}"/>
      </StackPanel>
    </Border>

    <!-- Central HUD symbology. The reticle and target brackets are screen-space Noesis elements. -->
    <Canvas Width="600" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <!-- Fine pitch ladder floating above the sightline. -->
      <Canvas Canvas.Left="170" Canvas.Top="78" Width="260" Height="110">
        <Canvas.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="{Binding HorizonRoll}" CenterX="130" CenterY="55"/>
            <TranslateTransform Y="{Binding PitchLadderOffset}"/>
          </TransformGroup>
        </Canvas.RenderTransform>
        <Line X1="78" Y1="12" X2="182" Y2="12" Stroke="#5A9BB7BB" StrokeThickness="1"/>
        <Line X1="90" Y1="31" X2="170" Y2="31" Stroke="#5A9BB7BB" StrokeThickness="1"/>
        <Line X1="102" Y1="50" X2="158" Y2="50" Stroke="#5A9BB7BB" StrokeThickness="1"/>
        <Line X1="90" Y1="69" X2="170" Y2="69" Stroke="#5A9BB7BB" StrokeThickness="1"/>
        <Line X1="78" Y1="88" X2="182" Y2="88" Stroke="#5A9BB7BB" StrokeThickness="1"/>
      </Canvas>
      <!-- Fixed flight director. -->
      <Ellipse Canvas.Left="251" Canvas.Top="171" Width="98" Height="98" Stroke="#3779EDE3" StrokeThickness="1"/>
      <Ellipse Canvas.Left="276" Canvas.Top="196" Width="48" Height="48" Stroke="#9B8AF2E8" StrokeThickness="1"/>
      <Line X1="300" Y1="130" X2="300" Y2="165" Stroke="{StaticResource Ion}" StrokeThickness="1.2"/>
      <Line X1="300" Y1="275" X2="300" Y2="310" Stroke="{StaticResource Ion}" StrokeThickness="1.2"/>
      <Line X1="210" Y1="220" X2="246" Y2="220" Stroke="{StaticResource Ion}" StrokeThickness="1.2"/>
      <Line X1="354" Y1="220" X2="390" Y2="220" Stroke="{StaticResource Ion}" StrokeThickness="1.2"/>
      <Line X1="292" Y1="220" X2="308" Y2="220" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
      <Line X1="300" Y1="212" X2="300" Y2="228" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
      <TextBlock Canvas.Left="314" Canvas.Top="202" Text="PIP" Foreground="#90D7D6" FontSize="8"/>
      <TextBlock Canvas.Left="314" Canvas.Top="214" Text="GUN / SOLUTION" Foreground="#7195A2" FontSize="7"/>
      <TextBlock Canvas.Left="200" Canvas.Top="247" Text="+  /  FLIGHT VECTOR  /  +" Foreground="#729CA6" FontSize="7" Width="200" TextAlignment="Center"/>
      <!-- Contact box follows a real world-space projection from the current target lock. -->
      <Canvas Canvas.Left="{Binding TargetLeft}" Canvas.Top="{Binding TargetTop}" Visibility="{Binding TargetVisibility}" Width="64" Height="64">
        <Canvas.RenderTransform><ScaleTransform x:Name="LockPulse" ScaleX="1" ScaleY="1" CenterX="32" CenterY="32"/></Canvas.RenderTransform>
        <Canvas.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="LockPulse" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.04" Duration="0:0:0.55"/>
          <DoubleAnimation Storyboard.TargetName="LockPulse" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.04" Duration="0:0:0.55"/>
        </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
        <Line X1="0" Y1="16" X2="0" Y2="0" Stroke="{StaticResource Amber}" StrokeThickness="2"/><Line X1="0" Y1="0" X2="16" Y2="0" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
        <Line X1="48" Y1="0" X2="64" Y2="0" Stroke="{StaticResource Amber}" StrokeThickness="2"/><Line X1="64" Y1="0" X2="64" Y2="16" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
        <Line X1="0" Y1="48" X2="0" Y2="64" Stroke="{StaticResource Amber}" StrokeThickness="2"/><Line X1="0" Y1="64" X2="16" Y2="64" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
        <Line X1="48" Y1="64" X2="64" Y2="64" Stroke="{StaticResource Amber}" StrokeThickness="2"/><Line X1="64" Y1="48" X2="64" Y2="64" Stroke="{StaticResource Amber}" StrokeThickness="2"/>
        <Ellipse Canvas.Left="29" Canvas.Top="29" Width="6" Height="6" Fill="{StaticResource Amber}"/>
      </Canvas>
      <StackPanel Canvas.Left="225" Canvas.Top="310" Width="150">
        <TextBlock Text="GUNS / ARMED" Foreground="{StaticResource Ion}" FontSize="9" HorizontalAlignment="Center"/>
        <TextBlock Text="DUAL M-42 PULSE" Foreground="#B4CBD1" FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
      </StackPanel>
    </Canvas>

    <!-- Lower glareshield: physical cockpit coaming sits behind this glass instrument strip. -->
    <Grid VerticalAlignment="Bottom" Height="104" Margin="8,0,8,8" Tag="InputSurface">
      <Border Background="#8A07131E" BorderBrush="#657DC7C8" BorderThickness="0,1,0,0"/>
      <Grid Margin="16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="VELOCITY / ATTITUDE" Style="{StaticResource Micro}"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Ion}" FontSize="22"/>
            <TextBlock Text="{Binding TimeText}" Foreground="#9CB7BF" FontSize="10" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
          </StackPanel>
          <TextBlock Text="{Binding AttitudeText}" Foreground="#C2D7DA" FontSize="9"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,20,0">
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ion}" FontSize="9"/>
          <TextBlock Text="{Binding ComboText}" Foreground="{StaticResource Amber}" FontSize="14" Margin="0,3,0,1"/>
          <ItemsControl ItemsSource="{Binding Feed}" MaxHeight="40">
            <ItemsControl.ItemTemplate><DataTemplate>
              <DockPanel Margin="0,1"><TextBlock Text="{Binding Stamp}" Foreground="#66C9CE" FontSize="8" Margin="0,0,8,0"/><TextBlock Text="{Binding Message}" Foreground="#B7CDD1" FontSize="8"/></DockPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="LMB / INTERACT OR AIM &amp; FIRE  ·  SPACE / BORESIGHT" Foreground="#80AEB8" FontSize="7" HorizontalAlignment="Center" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding WeaponStateText}" Foreground="{StaticResource Amber}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="FireButton" Content="✣  FIRE" Command="{Binding FireCommand}" Margin="0,0,7,0"/>
            <Button x:Name="BoostButton" Content="⇧  BOOST" Command="{Binding BoostCommand}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ViewModeText}" Foreground="{StaticResource Sky}" FontSize="8" HorizontalAlignment="Right" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="CAM" Command="{Binding ViewCommand}" Margin="0,0,5,0"/>
            <Button x:Name="PauseButton" Content="Ⅱ" Command="{Binding PauseCommand}" Margin="0,0,5,0"/>
            <Button Content="F11" Command="{Binding FullscreenCommand}" Margin="0,0,5,0"/>
            <Button Content="AUDIO" Command="{Binding SoundCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding Performance}" Foreground="#7797A2" FontSize="8" HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Small diagnostic glyphs live at the canopy edge. -->
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,120" IsHitTestVisible="False">
      <TextBlock Text="SYS / NOMINAL" Foreground="{StaticResource Ion}" FontSize="8"/>
      <TextBlock Text="{Binding Adapter}" Foreground="#7996A3" FontSize="8" MaxWidth="185" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120" IsHitTestVisible="False">
      <TextBlock Text="K-09 / SOLAR COORDINATES" Foreground="#7996A3" FontSize="8" HorizontalAlignment="Right"/>
      <TextBlock Text="{Binding PositionText}" Foreground="#A8C5CD" FontSize="8" HorizontalAlignment="Right" Margin="0,3,0,0"/>
    </StackPanel>
  </Grid>

  <!-- Alerts and system overlays. -->
  <Border Background="#5AF04D45" Visibility="{Binding DamageVisibility}" IsHitTestVisible="False"/>
  <Grid Visibility="{Binding PauseVisibility}" Background="#C706111A" Tag="InputSurface">
    <Border Width="440" Padding="30" Background="#EF0A1B29" BorderBrush="#83A7C0" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="FLIGHT COMPUTER / STANDBY" Foreground="{StaticResource Ion}" FontSize="10" HorizontalAlignment="Center"/>
        <TextBlock Text="PAUSED" Foreground="#F0FAF8" FontSize="36" FontWeight="Light" HorizontalAlignment="Center" Margin="0,8,0,10"/>
        <TextBlock Text="The fighter is coasting. Flight controls and the weapon system are waiting for your input." Foreground="#A9C4CD" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
        <Border Background="#42152D3A" BorderBrush="#536C9AA0" BorderThickness="1" Padding="12" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="FLIGHT CONTROLS" Foreground="{StaticResource Ion}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="ARROWS  PITCH / YAW       Q / E  ROLL" Foreground="#D1E3E4" FontSize="9" HorizontalAlignment="Center"/>
            <TextBlock Text="W / S  THRUST             A / D  STRAFE" Foreground="#D1E3E4" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="R / F  LIFT      RMB  STEER      MMB  FREE LOOK      LMB  AIM / FIRE" Foreground="#D1E3E4" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="SHIFT  AFTERBURNER           C  CHASE CAM" Foreground="#D1E3E4" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Button Content="RESUME FLIGHT" Command="{Binding PauseCommand}" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
  <Grid Visibility="{Binding GameOverVisibility}" Background="#E5080D16" Tag="InputSurface">
    <Border Width="500" Padding="32" Background="#F00E1B29" BorderBrush="#C77B72" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="PILOT EJECTION / SIGNAL LOST" Foreground="{StaticResource Red}" FontSize="11" HorizontalAlignment="Center"/>
        <TextBlock Text="MISSION FAILED" Foreground="#F5F5EF" FontSize="32" HorizontalAlignment="Center" Margin="0,8,0,10"/>
        <TextBlock Text="{Binding ScoreText}" Foreground="{StaticResource Amber}" FontSize="32" HorizontalAlignment="Center"/>
        <TextBlock Text="FINAL SORTIE SCORE" Foreground="{StaticResource Dim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,22"/>
        <Button x:Name="RestartButton" Content="↻  LAUNCH A NEW SORTIE" Command="{Binding RestartCommand}" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
