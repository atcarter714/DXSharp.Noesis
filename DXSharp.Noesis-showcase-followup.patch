diff --git a/samples/Starfighter/CockpitMeshFile.cs b/samples/Starfighter/CockpitMeshFile.cs
new file mode 100644
index 0000000..43cf3df
--- /dev/null
+++ b/samples/Starfighter/CockpitMeshFile.cs
@@ -0,0 +1,38 @@
+using System.Numerics;
+using System.Text;
+
+namespace Starfighter;
+
+/// <summary>Reads the bounded, versioned preview format generated by prepare-cockpit.py.</summary>
+public static class CockpitMeshFile {
+    public static IReadOnlyList<MeshData> Load( string path ) {
+        using var reader = new BinaryReader( File.OpenRead( path ) );
+        if ( Encoding.ASCII.GetString( reader.ReadBytes( 4 ) ) != "DXCM" || reader.ReadUInt32( ) != 1 )
+            throw new InvalidDataException( "Unsupported cockpit mesh format." );
+        uint count = reader.ReadUInt32( );
+        if ( count is 0 or > 256 ) throw new InvalidDataException( "Invalid chunk count." );
+        var result = new List<MeshData>( (int)count );
+        for ( int chunk = 0; chunk < count; chunk++ ) {
+            uint vc = reader.ReadUInt32( ), ic = reader.ReadUInt32( );
+            if ( vc is 0 or > 65535 || ic is 0 or > 3_000_000 || ic % 3 != 0 ||
+                 reader.BaseStream.Length - reader.BaseStream.Position < (long)vc * 36 + (long)ic * 2 )
+                throw new InvalidDataException( "Invalid cockpit mesh dimensions." );
+            var vertices = new Vertex[(int)vc]; var indices = new ushort[(int)ic];
+            for ( int i = 0; i < vertices.Length; i++ ) {
+                Vector3 p = ReadVector( ), n = ReadVector( ), c = ReadVector( );
+                if ( !float.IsFinite( p.LengthSquared( ) ) || !float.IsFinite( n.LengthSquared( ) ) ||
+                     MathF.Abs( n.LengthSquared( ) - 1 ) > 0.01f || !float.IsFinite( c.LengthSquared( ) ) )
+                    throw new InvalidDataException( "Invalid cockpit vertex." );
+                vertices[i] = new( p, n, c );
+            }
+            for ( int i = 0; i < indices.Length; i++ ) {
+                indices[i] = reader.ReadUInt16( );
+                if ( indices[i] >= vc ) throw new InvalidDataException( "Cockpit mesh index out of range." );
+            }
+            result.Add( new( vertices, indices ) );
+        }
+        if ( reader.BaseStream.Position != reader.BaseStream.Length ) throw new InvalidDataException( "Unexpected trailing mesh data." );
+        return result;
+        Vector3 ReadVector( ) => new( reader.ReadSingle( ), reader.ReadSingle( ), reader.ReadSingle( ) );
+    }
+}
