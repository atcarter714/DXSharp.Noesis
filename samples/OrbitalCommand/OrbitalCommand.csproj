<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Arkaen.OrbitalCommand</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../../assets/branding/DXSharp.Noesis.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DXSharp.Noesis/DXSharp.Noesis.csproj" />
    <PackageReference Include="Noesis.App" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <None Update="Ui/Dashboard.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ui/Solar/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/horizons.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/horizons-series.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Scene.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SolarScene.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
