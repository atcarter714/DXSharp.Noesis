<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="Fonts/#PT Root UI" TextElement.FontSize="14" TextElement.Foreground="#D9E6EE">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#70E5D5"/>
    <SolidColorBrush x:Key="Muted" Color="#879FAB"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#E60B1722"/>
      <Setter Property="BorderBrush" Value="#36486373"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#172C3B"/>
      <Setter Property="Foreground" Value="#E8F4F4"/>
      <Setter Property="BorderBrush" Value="#395463"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#28505A"/><Setter TargetName="Face" Property="BorderBrush" Value="#70E5D5"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#397076"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#70E5D5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
      <Setter Property="Background" Value="#0D202D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="#294351" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1D3947"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#204950"/><Setter TargetName="Row" Property="BorderBrush" Value="#70E5D5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- World labels use the same camera projection as the D3D12 meshes. Empty space passes input to the scene. -->
  <ItemsControl ItemsSource="{Binding Ships}" IsHitTestVisible="False">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemContainerStyle>
      <Style TargetType="ContentPresenter">
        <Setter Property="Canvas.Left" Value="{Binding AnchorX}"/>
        <Setter Property="Canvas.Top" Value="{Binding AnchorY}"/>
        <Setter Property="Visibility" Value="{Binding MarkerVisibility}"/>
      </Style>
    </ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Canvas>
          <Line X1="0" Y1="0" X2="{Binding LeaderX}" Y2="{Binding LeaderY}" Stroke="#7768B6BD" StrokeThickness="1"/>
          <Border Canvas.Left="{Binding LeaderX}" Canvas.Top="{Binding LeaderY}" Margin="0,-10,0,0" Background="#D9091C28" BorderBrush="#5573AFB5" BorderThickness="1" CornerRadius="3" Padding="6,3">
            <TextBlock Text="{Binding MarkerText}" FontSize="12" Foreground="#A0F0E4"/>
          </Border>
        </Canvas>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="202"/><RowDefinition Height="27"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
    <Border Tag="InputSurface" x:Name="HeaderPanel" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Padding="18,10" MinHeight="70" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="A R K A E N   /   K E P L E R" Foreground="{StaticResource Accent}" FontSize="12"/>
          <TextBlock x:Name="BrandTitle" Text="ORBITAL COMMAND" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource Caption}" Text="CREDITS"/><TextBlock x:Name="HeaderCredits" Text="{Binding Credits}" FontSize="20"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Style="{StaticResource Caption}" Text="RESEARCH"/><TextBlock x:Name="HeaderResearch" Text="{Binding Research}" FontSize="20"/></StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Style="{StaticResource Caption}" Text="FLEET"/><TextBlock x:Name="HeaderFleetCount" Text="{Binding FleetCount}" FontSize="20"/></StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding SolarMapButton}" Command="{Binding SolarMapCommand}" Margin="0,0,8,0" ToolTip="Solar System / Local Orbit"/>
          <Button x:Name="BriefingButton" Content="BRIEFING" Command="{Binding BriefingCommand}" Margin="0,0,8,0"/>
          <Button Content="F11" Command="{Binding FullscreenCommand}" ToolTip="Fullscreen · F11"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Tag="InputSurface" x:Name="FleetPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Style="{StaticResource Caption}" Text="01 / FLEET OPERATIONS"/><TextBlock Text="Kepler Anchorage" FontSize="20"/><TextBlock Text="All vessels · local orbital space" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        <ListBox x:Name="FleetList" Grid.Row="1" ItemsSource="{Binding Ships}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel><TextBlock Text="{Binding Name}" FontSize="14"/><DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding Role}" Foreground="#80B7C4" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="#88DFCE" FontSize="11" HorizontalAlignment="Right"/></DockPanel></StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Button x:Name="LaunchButton" Content="+  LAUNCH PATHFINDER" Command="{Binding LaunchCommand}" Background="#17423F" BorderBrush="#397E75" HorizontalContentAlignment="Center"/>
          <TextBlock Text="160 credits · maximum 8 active vessels" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorldSurface" Grid.Row="1" Grid.Column="1" Margin="20,4,20,22" Background="Transparent">
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="Beacon" Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,7,0">
            <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.5"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
          </Ellipse>
          <TextBlock Text="LIVE ORBITAL FEED" Foreground="#8BE2D4" FontSize="11"/>
        </StackPanel>
        <TextBlock Text="KEPLER / 07" FontSize="30" FontWeight="Light" Margin="0,6,0,0"/>
        <TextBlock Text="Terrestrial world · equatorial ring system" Foreground="#9CB6C3" FontSize="12"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Text="DRAG TO ORBIT   /   MIDDLE DRAG TO PAN   /   SCROLL TO ZOOM" Foreground="#A0BAC4" FontSize="11" HorizontalAlignment="Center"/>
        <TextBlock Text="Click a vessel or its label to select" Foreground="#608590" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
      <Border Visibility="{Binding SolarMapVisibility}" Tag="InputSurface" Background="#FF0B1722" BorderBrush="#36486373" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="SOL / REAL EPHEMERIDES" FontSize="21" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding SolarStatus}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform">
            <Canvas Width="560" Height="560" ClipToBounds="True">
              <Ellipse Canvas.Left="30" Canvas.Top="30" Width="500" Height="500" Stroke="#506A7A" StrokeThickness="1"/>
              <Line X1="30" Y1="280" X2="530" Y2="280" Stroke="#365261"/><Line X1="280" Y1="30" X2="280" Y2="530" Stroke="#365261"/>
              <Ellipse Canvas.Left="275" Canvas.Top="275" Width="10" Height="10" Fill="#FFC76F"/>
              <ItemsControl ItemsSource="{Binding PlanetMarkers}" Width="560" Height="560">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#70E5D5" VerticalAlignment="Top" Margin="0,0,4,0"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Text="{Binding Distance}" FontSize="10" Foreground="#879FAB"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Row="2"><TextBlock Text="{Binding SolarScaleText}" FontSize="12"/><TextBlock Text="Positions at snapshot epoch; marker sizes symbolic. No orbital propagation." FontSize="11" TextWrapping="Wrap"/><Button Content="{Binding SolarScaleButton}" Command="{Binding SolarScaleCommand}" Margin="0,6,0,0"/></StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Tag="InputSurface" x:Name="InspectorPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,0,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="02 / VESSEL TELEMETRY"/>
          <TextBlock Text="{Binding SelectedShip.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedShip.Role}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,5,0,18"/>
          <Border Background="#102E36" BorderBrush="#335A60" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="{Binding SelectedShip.Status}" Foreground="#8EEBD8" FontSize="12"/><TextBlock Text="{Binding SelectedShip.Distance}" FontSize="24" Margin="0,6,0,0"/><TextBlock Text="Distance from planetary center" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Caption}" Text="SURVEY COMPLETION"/>
          <ProgressBar x:Name="SurveyProgress" Value="{Binding SelectedShip.Progress, Mode=OneWay}" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
          <TextBlock Text="Outer-ring sweep: 22 simulation seconds. Completing a survey grants research and credits." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
          <Button x:Name="SurveyButton" Content="◇  SURVEY OUTER RING" Command="{Binding SurveyCommand}" Background="#19463F" BorderBrush="#4E8B7F" Margin="0,0,0,7"/>
          <Button Content="↗  ENGAGE PATROL" Command="{Binding PatrolCommand}" Margin="0,0,0,7"/>
          <Button Content="↙  RECALL TO ANCHORAGE" Command="{Binding RecallCommand}" Margin="0,0,0,7"/>
          <Button Content="◎  FOCUS CAMERA" Command="{Binding FocusCommand}" Margin="0,0,0,16"/>
          <TextBlock Style="{StaticResource Caption}" Text="COMMANDER CALL SIGN"/>
          <TextBox x:Name="CallSignInput" Text="{Binding CallSign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxLength="48" Padding="8"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Tag="InputSurface" x:Name="LogPanel" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Panel}" Margin="0,0,14,0" Padding="18,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Style="{StaticResource Caption}" Text="03 / MISSION FEED"/><TextBlock Text="{Binding Clock}" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,5"><ItemsControl ItemsSource="{Binding Events}">
          <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,5"><TextBlock Text="{Binding Time}" Foreground="#5BA9AD" Width="47" FontSize="12"/><TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl></ScrollViewer>
        <DockPanel Grid.Row="2">
          <Button x:Name="PauseButton" Content="{Binding PauseText}" Command="{Binding PauseCommand}" Width="112" FontSize="12" Padding="8,6"/>
          <TextBlock Text="TIME SCALE" Foreground="{StaticResource Muted}" FontSize="11" Margin="18,0,10,0" VerticalAlignment="Center"/>
          <Slider x:Name="TimeSlider" Minimum="0.25" Maximum="4" Value="{Binding Speed, Mode=TwoWay}" Width="135" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Accent}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>
    <Border Tag="InputSurface" x:Name="GraphicsPanel" Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel}" Padding="18,14">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="04 / RENDER CONTROLS"/>
        <DockPanel Margin="0,3,0,6"><TextBlock Text="Exposure" FontSize="12" Width="82" VerticalAlignment="Center"/><Slider x:Name="ExposureSlider" Minimum="0.5" Maximum="2.5" Value="{Binding Exposure, Mode=TwoWay}"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Atmosphere" FontSize="12" Width="82" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="2" Value="{Binding Atmosphere, Mode=TwoWay}"/></DockPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <CheckBox Content="Orbits" IsChecked="{Binding ShowOrbits, Mode=TwoWay}" FontSize="12"/>
          <CheckBox Grid.Column="1" Content="Labels" IsChecked="{Binding ShowLabels, Mode=TwoWay}" FontSize="12"/>
        </Grid>
        <CheckBox Content="Cinematic camera" IsChecked="{Binding AutoCamera, Mode=TwoWay}" FontSize="12" Margin="0,0,0,6"/>
        <Button x:Name="ResetViewButton" Content="RESET VIEW" Command="{Binding ResetCameraCommand}" FontSize="11" Padding="6,5"/>

      </StackPanel>
    </Border>
    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="2,9,2,0" IsHitTestVisible="False">
      <TextBlock Text="DXSHARP × NOESIS  /  DIRECT3D 12" Foreground="#64808E" FontSize="11"/>
      <TextBlock Text="{Binding Performance}" Foreground="#8AA6B3" FontSize="11" HorizontalAlignment="Right"/>
    </DockPanel>
  </Grid>

  <Grid Tag="InputSurface" x:Name="BriefingLayer" Visibility="{Binding BriefingVisibility}" Background="#CA02070D">
    <Border Style="{StaticResource Panel}" Width="660" MaxHeight="{Binding ActualHeight, ElementName=BriefingLayer}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Background="#FF0D1F2C" BorderBrush="#4A8B8E">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock Text="MISSION / KEPLER ANCHORAGE" Foreground="{StaticResource Accent}" FontSize="12"/>
        <TextBlock Text="Your fleet. One shared renderer." FontSize="29" Margin="0,10,0,18"/>
        <TextBlock Text="Command a small expedition above Kepler 07. Select any vessel, survey the outer ring for research, send it on patrol, or recall it to the anchorage. Launch two additional pathfinders with your starting credits." TextWrapping="Wrap" Foreground="#C3D5DE" FontSize="15" LineHeight="23"/>
        <Border Height="1" Background="#36515D" Margin="0,22,0,20"/>
        <TextBlock Text="Drag world or labels to orbit · Middle drag to pan&#10;Wheel to zoom · F to focus and follow selected vessel&#10;Space to pause · Home to reset · F11 for fullscreen&#10;Escape closes this briefing. Text fields retain keyboard input." TextWrapping="Wrap" Foreground="#9CB6C3" FontSize="13" LineHeight="24"/>
        <TextBlock Text="{Binding Adapter}" FontSize="12" Foreground="#6B929E" Margin="0,18,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Indexed GPU meshes, procedural planet and ring shading, XAML animation, MVVM commands, stencil clipping, DPI scaling, and isolated scene/UI command lists on one D3D12 queue." TextWrapping="Wrap" Foreground="#7899A5" FontSize="12" Margin="0,10,0,24"/>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="INTERFACE SCALE" Foreground="#A2BDC9" FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="−" Command="{Binding DecreaseUiCommand}" Padding="12,6"/>
          <TextBlock Grid.Column="2" Text="{Binding InterfaceScaleText}" Foreground="#A0E5D9" Margin="12,0" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Content="+" Command="{Binding IncreaseUiCommand}" Padding="12,6"/>
        </Grid>
        <Button x:Name="DismissButton" Content="RETURN TO COMMAND" Command="{Binding DismissCommand}" Background="#1E5149" HorizontalContentAlignment="Center"/>
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
</Grid>
